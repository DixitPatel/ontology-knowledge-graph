{%- liquid
  assign skin_tags = ''
  assign concern_tags = ''
  assign active_tags = ''
  assign aha_strength = ''
  for tag in product.tags
    if tag contains 'skin:'
      assign value = tag | remove_first: 'skin:' | replace: '-', ' ' | capitalize
      assign skin_tags = skin_tags | append: value | append: ', '
    endif
    if tag contains 'concern:'
      assign value = tag | remove_first: 'concern:' | replace: '-', ' ' | capitalize
      assign concern_tags = concern_tags | append: value | append: ', '
    endif
    if tag contains 'active:'
      assign value = tag | remove_first: 'active:' | upcase
      assign active_tags = active_tags | append: value | append: ', '
    endif
    if tag contains 'aha_strength:'
      assign aha_strength = tag | remove_first: 'aha_strength:'
    endif
  endfor
  assign skin_tags = skin_tags | remove_last: ', '
  assign concern_tags = concern_tags | remove_last: ', '
  assign active_tags = active_tags | remove_last: ', '

  # General skincare-glossary copy, used when tags are missing. Not lab-tested product claims.
  case product.handle
    when 'smooth-operator-aha-serum'
      assign fb_skin = 'Normal, oily and combination skin. Dry or sensitive skin: start slowly and patch test first.'
      assign fb_concerns = 'Rough texture, dullness, uneven tone and clogged-looking pores.'
      assign fb_active = 'AHA (alpha hydroxy acid) — a chemical exfoliant that loosens dead surface cells. Start 2–3 nights a week. Use sunscreen every day.'
    when 'cloud-whip-moisturiser'
      assign fb_skin = 'All skin types, especially dry, dehydrated and sensitive skin.'
      assign fb_concerns = 'Weak skin barrier, dryness, tightness and flaking.'
      assign fb_active = 'No exfoliating actives. A barrier moisturiser: humectants draw in water, emollients soften, occlusives seal it in.'
    when 'glow-barrier-duo'
      assign fb_skin = 'Normal, oily, combination and dry skin. Sensitive skin: add the serum slowly.'
      assign fb_concerns = 'Texture and dullness (serum) plus dryness and barrier support (moisturiser).'
      assign fb_active = 'AHA in the serum (exfoliates). Moisturiser has no acids and calms the skin after. Use sunscreen every day.'
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="product__accordion accordion quick-add-hidden">
    <details id="Details-am-i-for-you-{{ section.id }}" data-oneself-section="am_i_for_you">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">{{ 'sections.am_i_for_you.heading' | t }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="AmIForYouAccordion-{{ section.id }}">
        <ul>
          <li>
            <strong>{{ 'sections.am_i_for_you.skin_type' | t }}: </strong>
            {%- if skin_tags != blank -%}
              {{ skin_tags }}
            {%- elsif fb_skin != blank -%}
              {{ fb_skin }}
            {%- else -%}
              {{ 'sections.am_i_for_you.not_verified' | t }}
            {%- endif -%}
          </li>
          <li>
            <strong>{{ 'sections.am_i_for_you.concerns' | t }}: </strong>
            {%- if fb_concerns != blank -%}
              {{ fb_concerns }}
            {%- elsif concern_tags != blank -%}
              {{ concern_tags }}
            {%- else -%}
              {{ 'sections.am_i_for_you.not_verified' | t }}
            {%- endif -%}
          </li>
          {%- if fb_active != blank or active_tags != blank -%}
            <li>
              <strong>{{ 'sections.am_i_for_you.active_ingredients' | t }}: </strong>
              {%- if fb_active != blank -%}
                {{ fb_active }}
              {%- else -%}
                {{ active_tags }}
              {%- endif -%}
            </li>
          {%- endif -%}
        </ul>
      </div>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.am_i_for_you.name",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "t:sections.am_i_for_you.name"
    }
  ]
}
{% endschema %}
