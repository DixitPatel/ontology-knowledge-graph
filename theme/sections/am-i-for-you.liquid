{%- liquid
  assign skin_tags = ''
  assign concern_tags = ''
  assign active_tags = ''
  assign aha_strength = ''
  for tag in product.tags
    if tag contains 'skin:'
      assign value = tag | remove_first: 'skin:' | replace: '-', ' ' | capitalize
      assign skin_tags = skin_tags | append: value | append: ', '
    endif
    if tag contains 'concern:'
      assign value = tag | remove_first: 'concern:' | replace: '-', ' ' | capitalize
      assign concern_tags = concern_tags | append: value | append: ', '
    endif
    if tag contains 'active:'
      assign value = tag | remove_first: 'active:' | upcase
      assign active_tags = active_tags | append: value | append: ', '
    endif
    if tag contains 'aha_strength:'
      assign aha_strength = tag | remove_first: 'aha_strength:'
    endif
  endfor
  assign skin_tags = skin_tags | remove_last: ', '
  assign concern_tags = concern_tags | remove_last: ', '
  assign active_tags = active_tags | remove_last: ', '
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="product__accordion accordion quick-add-hidden">
    <details id="Details-am-i-for-you-{{ section.id }}" data-oneself-section="am_i_for_you">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">{{ 'sections.am_i_for_you.heading' | t }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="AmIForYouAccordion-{{ section.id }}">
        <ul>
          <li>
            <strong>{{ 'sections.am_i_for_you.skin_type' | t }}:</strong>
            {%- if skin_tags != blank -%}
              {{ skin_tags }}
            {%- else -%}
              {{ 'sections.am_i_for_you.not_verified' | t }}
            {%- endif -%}
          </li>
          <li>
            <strong>{{ 'sections.am_i_for_you.concerns' | t }}:</strong>
            {%- if concern_tags != blank -%}
              {{ concern_tags }}
            {%- else -%}
              {{ 'sections.am_i_for_you.not_verified' | t }}
            {%- endif -%}
          </li>
          {%- if active_tags != blank -%}
            <li>
              <strong>{{ 'sections.am_i_for_you.active_ingredients' | t }}:</strong>
              {{ active_tags }}
              {%- if aha_strength == 'unknown' -%}
                &mdash; {{ 'sections.am_i_for_you.strength_not_verified' | t }}
              {%- endif -%}
            </li>
          {%- endif -%}
        </ul>
      </div>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.am_i_for_you.name",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "t:sections.am_i_for_you.name"
    }
  ]
}
{% endschema %}
